{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowguard.dev/schemas/claim-0.1.json",
  "title": "FlowGuard claim",
  "description": "What an analysing agent asserts. The verifier refuses anything that does not satisfy this schema before it looks at the numbers, so a malformed claim cannot be argued into a verdict.",
  "type": "object",
  "required": [
    "claim_id",
    "target_lock",
    "declared_control_point",
    "declared_level",
    "claimed_coverage",
    "not_claimed"
  ],
  "additionalProperties": false,
  "properties": {
    "claim_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "flow": {
      "type": "string",
      "maxLength": 200
    },
    "target_lock": {
      "type": "object",
      "required": [
        "commit"
      ],
      "additionalProperties": false,
      "properties": {
        "commit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "declared_control_point": {
      "type": "string",
      "minLength": 1
    },
    "declared_level": {
      "enum": [
        "CONSISTENT_DECLARED",
        "SCOPED_ASSURANCE",
        "PROVEN"
      ]
    },
    "claimed_coverage": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "excluded": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "path_id",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "path_id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 8
          }
        }
      },
      "description": "The policy ceiling is 2; a claim may not exclude beyond it. Exclusions must name a real path and carry a reason of at least eight characters, because 'n/a' is not a reason."
    },
    "not_claimed": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^NC-[0-9]{2}$"
      },
      "description": "Codes from docs/NOT-CLAIMED.md. Free text is refused: a refusal nobody can check becomes boilerplate."
    },
    "evidence_tier": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3,
      "description": "0 nobody looked, 1 author-chosen, 2 owner-confirmed, 3 blind + ground truth"
    }
  }
}
